{
  "$comment": "Project settings for the owner's interactive sessions in a clone (/plan, /dispatch, /bootstrap, ordinary work). The implementing runs use .claude/run-settings.json via the Action's `settings` input, where the write-capable gh commands are denied; keep them out of a deny here, or the skills cannot run. Any change here is an always-read PR.",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run test:coverage:*)",
      "Bash(npm run coverage:patch:*)",
      "Bash(npm run build:*)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(gh api user)",
      "Bash(gh api repos/:*)",
      "Bash(gh repo view:*)",
      "Bash(gh variable get:*)",
      "Bash(gh project:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable set:*)",
      "Bash(gh variable delete:*)"
    ]
  },
  "includeCoAuthoredBy": false
}
