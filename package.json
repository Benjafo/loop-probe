{
  "name": "agentic-coding-repository-template",
  "version": "0.0.0",
  "private": true,
  "description": "Template repo for the Issue-to-PR loop. /bootstrap replaces the placeholder scripts with the chosen framework and test runner.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude='tools/**' --test-coverage-exclude='test/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "coverage:patch": "node tools/patch-coverage.mjs",
    "build": "echo \"no build step yet: /bootstrap wires one\"",
    "dev": "echo \"no dev server yet: /bootstrap wires one\"",
    "restore-config": "bash .github/scripts/restore-config.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  }
}
